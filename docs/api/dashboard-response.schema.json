{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wattwise.invalid/contracts/0.1-draft/dashboard-response",
  "title": "WattWise dashboard response proposal (sample fixture edition)",
  "description": "Draft; validates review samples, not an approved production contract. Application-specific invariants require tests beyond structural validation.",
  "oneOf": [
    {
      "$ref": "#/$defs/Dashboard"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    }
  ],
  "$defs": {
    "Meta": {
      "type": "object",
      "required": [
        "sample",
        "sampleLabel",
        "householdId",
        "timezone",
        "generatedAt",
        "contractVersion",
        "contractStatus",
        "sourceType",
        "asOf",
        "requestId",
        "scenario"
      ],
      "properties": {
        "sample": {
          "const": true
        },
        "sampleLabel": {
          "type": "string"
        },
        "householdId": {
          "type": "string"
        },
        "timezone": {
          "const": "Europe/Istanbul"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "contractVersion": {
          "const": "0.1-draft"
        },
        "contractStatus": {
          "const": "proposed"
        },
        "sourceType": {
          "const": "synthetic"
        },
        "settingsRevision": {
          "type": "integer",
          "minimum": 1
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "requestId": {
          "type": "string"
        },
        "scenario": {
          "enum": [
            "normal",
            "empty",
            "partial-data",
            "device-disconnected",
            "incomplete-setup",
            "error"
          ]
        }
      },
      "additionalProperties": true
    },
    "Period": {
      "type": "object",
      "required": [
        "start",
        "endExclusive"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "endExclusive": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "Coverage": {
      "type": "object",
      "required": [
        "status",
        "gaps"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "none",
            "uncertain"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Period"
          }
        }
      },
      "additionalProperties": true
    },
    "OptionalPeriod": {
      "oneOf": [
        { "$ref": "#/$defs/Period" },
        { "type": "null" }
      ]
    },
    "SetupCompleteness": {
      "type": "object",
      "required": ["status", "missingFields"],
      "properties": {
        "status": {
          "enum": ["complete", "incomplete"]
        },
        "missingFields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "code", "message"],
            "properties": {
              "field": { "enum": ["billingCycle", "tariff", "budget"] },
              "code": { "enum": ["billing_cycle_missing", "tariff_missing", "budget_missing"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "if": {
        "properties": { "status": { "const": "complete" } }
      },
      "then": {
        "properties": { "missingFields": { "maxItems": 0 } }
      },
      "else": {
        "properties": { "missingFields": { "minItems": 1 } }
      }
    },
    "Metric": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "classification",
        "unavailableReason",
        "explanation"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "W",
            "kWh",
            "TRY"
          ]
        },
        "classification": {
          "enum": [
            "measured",
            "calculated_remainder",
            "estimated_energy_cost",
            "forecast",
            "user_target",
            "unavailable"
          ]
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "Forecast": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "classification",
        "chargeBasis",
        "eligible",
        "energyEligible",
        "energyUnavailableReason",
        "methodId",
        "methodVersion",
        "calculatedAt",
        "asOf",
        "period",
        "historyPeriod",
        "validDays",
        "minimumValidDays",
        "observedEnergyKwh",
        "projectedEnergyKwh",
        "projectedPeriod",
        "isStale",
        "maturity",
        "assumptions",
        "unavailableReason",
        "explanation"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "const": "TRY"
        },
        "classification": {
          "const": "forecast"
        },
        "chargeBasis": {
          "enum": [
            "energy_only",
            "supported_invoice_components"
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "energyEligible": {
          "type": "boolean"
        },
        "energyUnavailableReason": {
          "type": ["string", "null"]
        },
        "methodId": {
          "type": "string"
        },
        "methodVersion": {
          "type": "string"
        },
        "calculatedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "period": {
          "$ref": "#/$defs/OptionalPeriod"
        },
        "historyPeriod": {
          "$ref": "#/$defs/OptionalPeriod"
        },
        "validDays": {
          "type": "integer",
          "minimum": 0
        },
        "minimumValidDays": {
          "type": "integer",
          "minimum": 1
        },
        "observedEnergyKwh": {
          "type": [
            "number",
            "null"
          ]
        },
        "projectedEnergyKwh": {
          "type": [
            "number",
            "null"
          ]
        },
        "projectedPeriod": {
          "$ref": "#/$defs/OptionalPeriod"
        },
        "isStale": {
          "type": "boolean"
        },
        "maturity": {
          "enum": [
            "early",
            "established",
            null
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": { "energyEligible": { "const": true } }
          },
          "then": {
            "properties": {
              "projectedEnergyKwh": { "type": "number" },
              "energyUnavailableReason": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "projectedEnergyKwh": { "type": "null" },
              "energyUnavailableReason": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligible": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unavailableReason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eligible": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "unavailableReason": {
                "type": "null"
              },
              "energyEligible": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "Dashboard": {
      "type": "object",
      "required": [
        "meta",
        "billingCycle",
        "setupCompleteness",
        "currentPower",
        "todayEnergy",
        "selectedPeriodEnergy",
        "contributions",
        "devices",
        "collector",
        "trend",
        "cost",
        "forecast",
        "budget",
        "budgetPosition"
      ],
      "properties": {
        "meta": {
          "allOf": [
            { "$ref": "#/$defs/Meta" },
            { "required": ["settingsRevision"] }
          ]
        },
        "billingCycle": {
          "$ref": "#/$defs/OptionalPeriod"
        },
        "setupCompleteness": {
          "$ref": "#/$defs/SetupCompleteness"
        },
        "currentPower": {
          "allOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "object",
              "required": [
                "observedAt",
                "receivedAt",
                "status"
              ],
              "properties": {
                "observedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "receivedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "status": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "todayEnergy": {
          "allOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "object",
              "required": [
                "period",
                "partialDay",
                "coverage"
              ],
              "properties": {
                "period": {
                  "$ref": "#/$defs/Period"
                },
                "partialDay": {
                  "type": "boolean"
                },
                "coverage": {
                  "$ref": "#/$defs/Coverage"
                }
              },
              "additionalProperties": true
            }
          ]
        },
        "selectedPeriodEnergy": {
          "allOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "object",
              "required": [
                "period",
                "coverage"
              ],
              "properties": {
                "unit": {
                  "const": "kWh"
                },
                "period": {
                  "$ref": "#/$defs/Period"
                },
                "coverage": {
                  "$ref": "#/$defs/Coverage"
                }
              }
            }
          ]
        },
        "contributions": {
          "type": "object",
          "required": [
            "period",
            "coverage",
            "household",
            "appliances",
            "other"
          ],
          "properties": {
            "period": {
              "$ref": "#/$defs/Period"
            },
            "coverage": {
              "$ref": "#/$defs/Coverage"
            },
            "household": {
              "allOf": [
                {
                  "$ref": "#/$defs/Metric"
                },
                {
                  "type": "object",
                  "required": [
                    "coverage"
                  ],
                  "properties": {
                    "unit": {
                      "const": "kWh"
                    },
                    "coverage": {
                      "$ref": "#/$defs/Coverage"
                    }
                  }
                }
              ]
            },
            "appliances": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/Metric"
                  },
                  {
                    "type": "object",
                    "required": [
                      "deviceId",
                      "name",
                      "status",
                      "sharePercent",
                      "coverage"
                    ],
                    "properties": {
                      "deviceId": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "sharePercent": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "coverage": {
                        "$ref": "#/$defs/Coverage"
                      }
                    },
                    "additionalProperties": true
                  }
                ]
              }
            },
            "other": {
              "$ref": "#/$defs/Metric"
            }
          },
          "additionalProperties": true
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "deviceId",
              "name",
              "scope",
              "status",
              "lastReadingAt",
              "lastReceivedAt",
              "sourceType",
              "unavailableReason",
              "explanation"
            ],
            "properties": {
              "deviceId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "scope": {
                "enum": [
                  "household",
                  "appliance"
                ]
              },
              "status": {
                "enum": [
                  "reporting",
                  "stale",
                  "unreachable",
                  "awaiting_first_reading",
                  "configuration_error"
                ]
              },
              "lastReadingAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "lastReceivedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "sourceType": {
                "const": "synthetic"
              },
              "unavailableReason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "explanation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "collector": {
          "type": "object",
          "required": [
            "collectorId",
            "status",
            "lastContactAt",
            "pendingCount",
            "pendingCountReportedAt",
            "explanation"
          ],
          "properties": {
            "collectorId": {
              "type": "string"
            },
            "status": {
              "enum": [
                "reporting",
                "unreachable",
                "delayed",
                "unknown"
              ]
            },
            "lastContactAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "pendingCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "pendingCountReportedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "explanation": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "trend": {
          "type": "object",
          "required": [
            "scope",
            "unit",
            "resolution",
            "period",
            "buckets"
          ],
          "properties": {
            "scope": {
              "const": "household"
            },
            "unit": {
              "const": "kWh"
            },
            "resolution": {
              "enum": [
                "hour",
                "day"
              ]
            },
            "period": {
              "$ref": "#/$defs/Period"
            },
            "buckets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "endExclusive",
                  "value",
                  "partialBucket",
                  "coverage"
                ],
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endExclusive": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "partialBucket": {
                    "type": "boolean"
                  },
                  "coverage": {
                    "$ref": "#/$defs/Coverage"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "cost": {
          "allOf": [
            { "$ref": "#/$defs/Metric" },
            {
              "required": ["period"],
              "properties": {
                "period": { "$ref": "#/$defs/OptionalPeriod" }
              }
            }
          ]
        },
        "forecast": {
          "$ref": "#/$defs/Forecast"
        },
        "budget": {
          "type": "object",
          "required": [
            "value",
            "unit",
            "classification",
            "chargeBasis",
            "period",
            "unavailableReason",
            "explanation"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "const": "TRY"
            },
            "classification": {
              "const": "user_target"
            },
            "chargeBasis": {
              "type": "string"
            },
            "period": {
              "$ref": "#/$defs/OptionalPeriod"
            },
            "unavailableReason": {
              "type": ["string", "null"]
            },
            "explanation": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": true
        },
        "budgetPosition": {
          "type": "object",
          "required": [
            "state",
            "projectedDifference",
            "unit",
            "period",
            "forecastCalculatedAt",
            "unavailableReason",
            "explanation"
          ],
          "properties": {
            "state": {
              "enum": [
                "on_track",
                "at_target",
                "forecast_over",
                "already_exceeded",
                "pending",
                "unavailable"
              ]
            },
            "projectedDifference": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "const": "TRY"
            },
            "period": {
              "$ref": "#/$defs/OptionalPeriod"
            },
            "forecastCalculatedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "unavailableReason": {
              "type": [
                "string",
                "null"
              ]
            },
            "explanation": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "meta",
        "error"
      ],
      "properties": {
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable",
            "retryAfterSeconds",
            "fieldErrors"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "retryAfterSeconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "fieldErrors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "code",
                  "message"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
