# Copy to backend/.env. No real credentials belong in version control.
WATTWISE_DATABASE_URL=sqlite:///./var/wattwise.db
WATTWISE_ENABLE_DEMO_API=false
WATTWISE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# PostgreSQL option, once a local database/user exists:
# WATTWISE_DATABASE_URL=postgresql+psycopg://wattwise:REPLACE_ME@localhost:5432/wattwise
